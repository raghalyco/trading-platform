# Shared by scanner/, signal_engine/, and execution/ via shared/kite_auth.py
# and shared/config.py. Copy this file to .env in the trading-platform root
# and fill in real values. Never commit .env.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Telegram alerts (optional). Used by all three subsystems for their own
# alert formatting; each still decides what/when to send.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
